{
  "name": "bancai-digital-human-avatar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "板材检测项目数字人 · 3D 形象前端（three.js + three-vrm）",
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=iife --outfile=dist/avatar.bundle.js --loader:.js=js",
    "watch": "esbuild src/main.js --bundle --format=iife --outfile=dist/avatar.bundle.js --watch"
  },
  "dependencies": {
    "three": "0.180.0",
    "@pixiv/three-vrm": "3.4.2"
  },
  "devDependencies": {
    "esbuild": "0.25.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
